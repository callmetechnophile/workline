# ==============================================================================
# WORKLINE AI — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Injected into Vercel / Netlify Project Settings for the Next.js frontend.
#
# IMPORTANT SECURITY RULES:
# 1. ONLY variables prefixed with NEXT_PUBLIC_ are bundled into the browser.
# 2. NEVER put database passwords, AWS secret keys, or service tokens here.
# 3. All AI model inference and payment verification execute server-side on Render.
# ==============================================================================

# Core Backend Gateway API URL (R1 Service URL on Render)
# Production example: https://workline-core-gateway.onrender.com
# Local development: http://localhost:10000
NEXT_PUBLIC_API_URL=https://workline-core-gateway.onrender.com

# Clerk Authentication Publishable Key (Safe for browser / client-side SDK)
# Obtain from: https://dashboard.clerk.com -> API Keys -> Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# Frontend Application Canonical URL
# Production example: https://workline.vercel.app (or custom domain)
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://workline.vercel.app
