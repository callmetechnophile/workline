# ==============================================================================
# Workline Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Server & Network Configuration (Handled automatically on Render via $PORT)
PORT=10000
WORKLINE_ENV=development
WORKLINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Service Mesh: Downstream Microservice URLs (Private internal networking on Render)
# ==============================================================================
WORKLINE_R2_URL=http://localhost:10002
WORKLINE_R3_URL=http://localhost:10003
WORKLINE_R4_URL=http://localhost:10004
WORKLINE_R5_URL=http://localhost:10005

# Service Mesh Mutual Authentication Key (Never expose to browser)
WORKLINE_SERVICE_AUTH_KEY=your_service_mesh_auth_key_here

# ==============================================================================
# AI & Image Generation — Amazon Bedrock (R2 ONLY)
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_RESEARCH_MODEL_ID=deepseek.r1-v1:0
BEDROCK_FAST_CODE_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REPORT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0

# ==============================================================================
# Knowledge & Databases (R3 ONLY)
# ==============================================================================
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_USER=root
SURREALDB_PASSWORD=root
SURREALDB_NAMESPACE=workline
SURREALDB_DATABASE=workline

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==============================================================================
# x402 Monetization on Algorand (R5 & R1)
# ==============================================================================
WORKLINE_X402_NETWORK=algorand-mainnet
WORKLINE_X402_ASSET=USDC
WORKLINE_X402_ASSET_ID=31566704
WORKLINE_X402_PAY_TO=WORKLINE24EUSDCALGORANDTREASURYRECIPIENT402XXXXXXXXXXXXXX
WORKLINE_X402_FACILITATOR_URL=https://facilitator.goplausible.com
WORKLINE_X402_ENABLED=true
WORKLINE_X402_MODE=production
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Timeout overrides
WORKLINE_CONNECT_TIMEOUT=5.0
WORKLINE_READ_TIMEOUT=30.0
