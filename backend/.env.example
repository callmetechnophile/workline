# ==============================================================================
# Workline R1 Core Gateway Environment Configuration (.env.example)
# ==============================================================================

# Server & Network Configuration (Handled automatically on Render via $PORT)
PORT=10000
WORKLINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://worklineai.netlify.app

# Downstream Microservice Interconnect URLs (Private internal networking on Render)
WORKLINE_R2_URL=http://localhost:10002
WORKLINE_R3_URL=http://localhost:10003
WORKLINE_R4_URL=http://localhost:10004
WORKLINE_R5_URL=http://localhost:10005
