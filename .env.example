# ==============================================================================
# WORKLINE AI PLATFORM — CONSOLIDATED ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT AND POPULATE WITH SAFE VALUES.
# NEVER COMMIT THE ACTUAL .env FILE OR ANY REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ==============================================================================
# 1. CORE PLATFORM & RUNTIME CONFIGURATION
# ==============================================================================
# Environment mode: 'development', 'test', 'production'
WORKLINE_ENV=development

# Server port (automatically assigned on Render via $PORT; local default: 10000)
PORT=10000

# Base URL for public links and callback handlers
WORKLINE_BASE_URL=http://localhost:10000

# Allowed CORS origins for browser communication
WORKLINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://worklineai.netlify.app

# Gateway HTTP timeouts (in seconds)
WORKLINE_CONNECT_TIMEOUT=5.0
WORKLINE_READ_TIMEOUT=30.0

# ==============================================================================
# 2. SERVICE MESH INTER-SERVICE URLS (R1 Gateway & Internal Mesh Routing)
# ==============================================================================
# Downstream microservice target URLs for hub-and-spoke internal communication
WORKLINE_R1_URL=http://localhost:10000
WORKLINE_R2_URL=http://localhost:10002
WORKLINE_R3_URL=http://localhost:10003
WORKLINE_R4_URL=http://localhost:10004
WORKLINE_R5_URL=http://localhost:10005

# Service Mesh Shared Secret Key (Used across R1-R5 for mutual bearer token auth)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WORKLINE_SERVICE_AUTH_KEY=your_service_mesh_auth_key_here

# Service-specific token overrides (if using granular per-service tokens)
R2_SERVICE_TOKEN=your_r2_service_token_here
R3_SERVICE_TOKEN=your_r3_service_token_here
R4_SERVICE_TOKEN=your_r4_service_token_here
R5_SERVICE_TOKEN=your_r5_service_token_here

# ==============================================================================
# 3. AI & MODEL INFERENCE (Amazon Bedrock / Google ADK / PaperBanana)
# ==============================================================================
# Amazon Bedrock AWS Region (e.g. us-east-1, us-west-2)
AWS_REGION=us-east-1

# Optional Static AWS Credentials (SET ON R2 RENDER SERVICE ONLY if not using IAM Role)
# NEVER EXPOSE TO FRONTEND BUNDLE
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Centralized Bedrock Model IDs (Configuration-Driven)
BEDROCK_RESEARCH_MODEL_ID=deepseek.r1-v1:0
BEDROCK_FAST_CODE_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REPORT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0

# Optional Voice / Speech Synthesis Key (Sarvam AI for Indian vernacular speech)
SARVAM_API_KEY=

# ==============================================================================
# 4. KNOWLEDGE & DATA STORAGE (R3 Knowledge Microservice)
# ==============================================================================
# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# SurrealDB Document & Graph Database
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_USER=root
SURREALDB_PASSWORD=root
SURREALDB_NAMESPACE=workline
SURREALDB_DATABASE=workline

# Embedding Provider: 'local', 'gemini', 'huggingface'
WORKLINE_EMBEDDING_PROVIDER=local

# ==============================================================================
# 5. MONETIZATION & PAYMENTS (x402 Protocol on Algorand — R5 Procurement & R1)
# ==============================================================================
# Algorand Network: 'algorand-mainnet' or 'algorand-testnet'
WORKLINE_X402_NETWORK=algorand-mainnet

# Settlement Asset: Always USDC on Algorand
WORKLINE_X402_ASSET=USDC

# Asset ID: 31566704 (Mainnet USDC) or 10458941 (Testnet USDC)
WORKLINE_X402_ASSET_ID=31566704

# Workline Treasury Algorand Wallet Address (58-character public receiving address)
WORKLINE_X402_PAY_TO=WORKLINE24EUSDCALGORANDTREASURYRECIPIENT402XXXXXXXXXXXXXX

# GoPlausible x402 Facilitator Verification Endpoint
WORKLINE_X402_FACILITATOR_URL=https://facilitator.goplausible.com

# Payment Challenge Time-to-Live in minutes
WORKLINE_X402_TTL_MINUTES=30

# Feature Flag: Enable x402 payment enforcement
WORKLINE_X402_ENABLED=true

# Execution Mode: 'production', 'testnet', 'local'
WORKLINE_X402_MODE=production

# CoinGecko API Endpoint for informational USD->INR post-settlement report snapshot
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ==============================================================================
# 6. PROCUREMENT & COMPONENT SUPPLIERS (R5 Procurement Microservice)
# ==============================================================================
# Optional Nexar / Altium Component Intelligence API
WORKLINE_NEXAR_CLIENT_ID=
WORKLINE_NEXAR_CLIENT_SECRET=
WORKLINE_NEXAR_ENDPOINT=https://api.nexar.com/graphql
WORKLINE_NEXAR_ENABLED=false

# ==============================================================================
# 7. ARMOURIQ TRUST & GOVERNANCE
# ==============================================================================
# Optional external ArmourIQ policy gateway credentials
ARMOURIQ_API_KEY=
ARMOURIQ_BASE_URL=https://api.armouriq.io

# ==============================================================================
# 8. COLLABORATION, TEAMS & INVITATIONS
# ==============================================================================
# Server-side HMAC-SHA-256 secret for protecting 6-character team join codes
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TEAM_JOIN_CODE_SECRET=your_team_join_code_hmac_secret_here

# Configurable Join Code Time-To-Live in seconds (default: 86400 / 24 hours)
TEAM_JOIN_CODE_TTL_SECONDS=86400

# Optional Asymmetric RSA-3072 Keypair for encrypted/signed invitation payloads
TEAM_RSA_PUBLIC_KEY=
TEAM_RSA_PRIVATE_KEY=

# Secure Team Invitation Key (256-bit AES-GCM encryption secret for link tokens)
WORKLINE_INVITATION_KEY_V1=your_256_bit_invitation_encryption_key_hex_here
WORKLINE_INVITATION_DEFAULT_TTL_DAYS=7

# Optional SMTP Email Dispatch Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@workline.app

# ==============================================================================
# 9. AUTHENTICATION (Clerk — Backend Server-Side)
# ==============================================================================
CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_JWKS_URL=

# ==============================================================================
# 10. FRONTEND PUBLIC VARIABLES (Netlify Deployment Only)
# ==============================================================================
# ONLY variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:10000
NEXT_PUBLIC_SITE_URL=https://worklineai.netlify.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# ==============================================================================
# 11. GIT & CLI INTEGRATION
# ==============================================================================
GITHUB_TOKEN=
GITHUB_USER=
WORKLINE_API_URL=http://localhost:10000
WORKLINE_AUTH_TOKEN=
