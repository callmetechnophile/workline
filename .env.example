# ==============================================================================
# WORKLINE / ARMOURFLOW PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
APP_ENV=development                       # development, staging, production
WORKLINE_ENV=development                  # development, staging, production
WORKLINE_ALLOW_DEV_AUTH=true              # Set to false in production
LOG_LEVEL=INFO

# Frontend & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000
WORKLINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. AWS FOUNDATION & CREDENTIALS
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# For local development with static keys; In AWS ECS/Lambda, resolved via IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LocalStack emulation (Optional, leave blank for real AWS)
# DYNAMODB_ENDPOINT_URL=http://localhost:4566
# EVENTBRIDGE_ENDPOINT_URL=http://localhost:4566
# SNS_ENDPOINT_URL=http://localhost:4566
# STEPFUNCTIONS_ENDPOINT_URL=http://localhost:4566
# CLOUDWATCH_ENDPOINT_URL=http://localhost:4566

# ------------------------------------------------------------------------------
# 3. AWS SERVERLESS & MESSAGING SERVICES
# ------------------------------------------------------------------------------
# API Gateway & Base Path
API_GATEWAY_BASE_PATH=

# Amazon DynamoDB (Application Metadata & Idempotency)
DYNAMODB_TABLE_NAME=workline-metadata-dev

# Amazon S3 (Artifacts, Reports, Exports, Datasheets)
WORKLINE_ARTIFACTS_BUCKET=workline-artifacts-dev-123456789012
WORKLINE_KMS_KEY_ID=

# Amazon SQS (Asynchronous Task Queue & Dead Letter Queue)
WORKLINE_SQS_QUEUE_URL=
WORKLINE_SQS_DLQ_URL=

# Amazon EventBridge (Domain Event Bus)
EVENTBRIDGE_BUS_NAME=workline-events-dev

# Amazon SNS (Alert Fan-out Topic)
SNS_ALERTS_TOPIC_ARN=

# AWS Step Functions (Multi-Agent State Machine ARN)
STEP_FUNCTIONS_WORKFLOW_ARN=

# Amazon CloudWatch (Namespace)
CLOUDWATCH_NAMESPACE=Workline/Platform

# ------------------------------------------------------------------------------
# 4. AUTHORITATIVE GRAPH DATABASE: SURREALDB (PRESERVED)
# ------------------------------------------------------------------------------
SURREALDB_URL=http://localhost:8001
SURREALDB_NAMESPACE=workline
SURREALDB_DATABASE=workline
SURREALDB_USER=root
SURREALDB_PASSWORD=root

# ------------------------------------------------------------------------------
# 5. AUTHORITATIVE VECTOR ENGINE: QDRANT (PRESERVED)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 6. SEARCH & INDEXING: AMAZON OPENSEARCH SERVICE
# ------------------------------------------------------------------------------
OPENSEARCH_ENDPOINT=

# ------------------------------------------------------------------------------
# 7. IDENTITY & RBAC: AMAZON COGNITO
# ------------------------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWKS_URL=

# ------------------------------------------------------------------------------
# 8. FOUNDATIONAL AI: AMAZON BEDROCK
# ------------------------------------------------------------------------------
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FAST_CODE_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REPORT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0

# ------------------------------------------------------------------------------
# 9. SECURITY & CRYPTOGRAPHIC GOVERNANCE: ARMORIQ
# ------------------------------------------------------------------------------
ARMORIQ_SECRET_KEY=
ARMOURIQ_BASE_URL=https://api.armouriq.io
ARMOURIQ_API_KEY=

# ------------------------------------------------------------------------------
# 10. MULTI-AGENT INTEROPERABILITY: A2A & BINDU PROTOCOL
# ------------------------------------------------------------------------------
BINDU_ENABLED=true
BINDU_ENDPOINT=http://localhost:8080/bindu
A2A_BROKER_URL=

# ------------------------------------------------------------------------------
# 11. RESEARCH & COMPONENT INTELLIGENCE
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
# arXiv Academic Literature Search (Open-Access, No API Key Required)
ARXIV_BASE_URL=https://export.arxiv.org/api/query
RESEARCH_PAPER_PROVIDER=arxiv
# Anakin Web Scraper (Installed via anakin-cli; open-source / local execution)
ANAKIN_ENABLED=true
ANAKIN_BASE_URL=https://api.anakin.io/v1
# Nexar GraphQL API (Official Provider for Octopart Component Intelligence & Stock)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
