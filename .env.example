# Workline Platform Environment Configuration Template
# COPY TO .env AND POPULATE WITH SECURE SECRETS (NEVER COMMIT .env)

# Core Platform
WORKLINE_ENV=development
WORKLINE_BASE_URL=https://workline.app

# Secure Team Invitation Key (256-bit / 32-byte hex or base64 secret)
# Generated via: python -c "import secrets; print(secrets.token_hex(32))"
WORKLINE_INVITATION_KEY_V1=your_256_bit_invitation_encryption_key_hex_here
WORKLINE_INVITATION_DEFAULT_TTL_DAYS=7

# SurrealDB & Qdrant Configuration
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=workline
SURREALDB_DB=workline

QDRANT_HOST=localhost
QDRANT_PORT=6333
