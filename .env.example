# ==============================================================================
# ARMOURFLOW AI / WORKFLOWGUIDE AI — PLATFORM CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real secrets or production credentials to version control.
# ==============================================================================

# ============================================================
# 1. APPLICATION
# ============================================================
APP_ENV=development
APP_NAME=ArmourFlow AI
APP_VERSION=1.0.0
PORT=10000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ============================================================
# 2. ARMOURFLOW CLI
# ============================================================
CLI_OUTPUT_FORMAT=rich
CLI_DEFAULT_PROJECT=default

# ============================================================
# 3. GOOGLE ADK
# ============================================================
ADK_ENABLED=true
ADK_RUNTIME=google_adk_v1

# ============================================================
# 4. CONTROL FABRIC
# ============================================================
CONTROL_FABRIC_ENDPOINT=internal://control-fabric
CONTROL_FABRIC_TIMEOUT=60.0

# ============================================================
# 5. SURREALDB
# ============================================================
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_NAMESPACE=workline
SURREALDB_DATABASE=workline
SURREALDB_USER=root
SURREALDB_PASSWORD=root

# ============================================================
# 6. AMAZON BEDROCK
# ============================================================
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FAST_CODE_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ============================================================
# 7. A2A (AGENT-TO-AGENT INTEROPERABILITY)
# ============================================================
A2A_ENABLED=true
A2A_ENDPOINT=internal://a2a-gateway
A2A_TIMEOUT=30.0

# ============================================================
# 8. BINDU (EXTERNAL AGENT CONNECTIVITY)
# ============================================================
BINDU_ENABLED=true
BINDU_ENDPOINT=http://localhost:8080/bindu
BINDU_API_KEY=

# ============================================================
# 9. TAVILY (WEB SEARCH & EXTRACTION)
# ============================================================
TAVILY_ENABLED=true
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=15.0

# ============================================================
# 10. FREEPHDLABOR (LITERATURE & PAPER RETRIEVAL)
# ============================================================
FREEPHDLABOR_ENABLED=true
FREEPHDLABOR_BASE_URL=https://api.freephdlabor.com/v1
FREEPHDLABOR_API_KEY=
FREEPHDLABOR_TIMEOUT_SECONDS=15.0

# ============================================================
# 11. ANAKIN (DEEP SCRAPING & CRAWLING)
# ============================================================
ANAKIN_ENABLED=false
ANAKIN_BASE_URL=https://api.anakin.ai/v1
ANAKIN_API_KEY=
ANAKIN_TIMEOUT_SECONDS=20.0
ANAKIN_MCP_ENABLED=false

# ============================================================
# 12. ARMORIQ (AUTHORIZATION BOUNDARY)
# ============================================================
ARMORIQ_ENABLED=true
ARMOURIQ_BASE_URL=https://api.armouriq.io
ARMORIQ_SECRET_KEY=
ARMOURIQ_API_KEY=

# ============================================================
# 13. HARNESS (EVALUATION & BENCHMARKS)
# ============================================================
HARNESS_ENABLED=true
HARNESS_ENDPOINT=internal://harness
HARNESS_API_KEY=

# ============================================================
# 14. GRAPHQL (CLIENT & APPLICATION API LAYER)
# ============================================================
GRAPHQL_ENABLED=true
GRAPHQL_PATH=/graphql
GRAPHQL_PLAYGROUND_ENABLED=true
GRAPHQL_INTROSPECTION_ENABLED=true
GRAPHQL_MAX_QUERY_DEPTH=10
GRAPHQL_MAX_QUERY_COMPLEXITY=100
GRAPHQL_REQUEST_TIMEOUT=30.0
